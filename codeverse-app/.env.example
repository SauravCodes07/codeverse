# CodeVerse - Environment Configuration

# Server
PORT=3000
NODE_ENV=production

# Database
DATABASE_URL=postgresql://codeverse_user:secure_password_123@postgres:5432/codeverse
DB_HOST=postgres
DB_PORT=5432
DB_NAME=codeverse
DB_USER=codeverse_user
DB_PASSWORD=secure_password_123

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET=codeverse-executions

# gRPC Executor
EXECUTOR_HOST=executor.codeverse.svc.cluster.local
EXECUTOR_PORT=50051

# JWT & Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=7d

# AI Service
AI_SERVICE_URL=http://ai-service:5000
AI_SERVICE_TOKEN=your-ai-service-token

# Logging
LOG_LEVEL=info

# Feature Flags
ENABLE_AI_FEEDBACK=true
ENABLE_TEST_CASES=true
ENABLE_COLLABORATIVE_EDITING=true
ENABLE_REAL_TIME_UPDATES=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Sandbox Defaults
DEFAULT_EXECUTION_TIMEOUT_SECONDS=30
DEFAULT_MEMORY_LIMIT_MB=512
DEFAULT_CPU_LIMIT_CORES=1
