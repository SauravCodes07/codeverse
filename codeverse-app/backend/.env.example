# CodeVerse Backend Environment Configuration

# Node Environment
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codeverse

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-in-production-please

# Execution Limits
EXECUTION_TIMEOUT_SECONDS=10
MEMORY_LIMIT_MB=512
MAX_FILE_SIZE_MB=50

# Sandbox Configuration
SANDBOX_TYPE=gvisor
DOCKER_REGISTRY=docker.io

# API Configuration
CORS_ORIGIN=http://localhost:5173
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX_REQUESTS=100

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# AWS S3 (for file storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=codeverse-code-storage

# OpenAI API (for AI feedback)
OPENAI_API_KEY=

# Monitoring & Logging
SENTRY_DSN=

# Session Management
SESSION_SECRET=change-this-to-random-string
SESSION_TIMEOUT_MINUTES=60

# Feature Flags
ENABLE_REAL_TIME_COLLAB=true
ENABLE_AI_FEEDBACK=true
ENABLE_CHALLENGE_MODE=true
ENABLE_LEADERBOARD=true
