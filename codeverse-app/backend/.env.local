# CodeVerse Backend - Development Environment

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# PostgreSQL Development Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codeverse

# Redis Development
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Secret (change in production!)
JWT_SECRET=dev-jwt-secret-key-123456789

# Execution Settings
EXECUTION_TIMEOUT_SECONDS=10
MEMORY_LIMIT_MB=512
MAX_FILE_SIZE_MB=50

# Sandbox
SANDBOX_TYPE=gvisor
DOCKER_REGISTRY=docker.io

# CORS for local development
CORS_ORIGIN=http://localhost:5173

# API Rate Limiting
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX_REQUESTS=100

# Optional services (comment out if not available)
# AWS_REGION=us-east-1
# OPENAI_API_KEY=sk-...

# Session
SESSION_SECRET=dev-session-secret-123456789
SESSION_TIMEOUT_MINUTES=60

# Features
ENABLE_REAL_TIME_COLLAB=true
ENABLE_AI_FEEDBACK=false
ENABLE_CHALLENGE_MODE=true
ENABLE_LEADERBOARD=true
